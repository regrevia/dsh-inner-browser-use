{
  "name": "dsh-inner-browser-use",
  "version": "0.34.84",
  "description": "An agent-owned Chromium sidecar mirrored into the DeepSeek Harness right column: the agent drives it, the person watches and can take the mouse, and logins survive restarts.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "sidecar.js",
    "tools.js",
    "read.js",
    "review.js",
    "client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "scripts/doctor.mjs",
    "scripts/check-flash-window.mjs",
    "scripts/check-flash-mirror.mjs",
    "scripts/check-flash-local.mjs",
    "scripts/check-flash-tools.mjs",
    "runtime/",
    "docs/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser-use",
    "computer-use",
    "chrome",
    "cdp",
    "screencast",
    "deepseek"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "breadth": "node scripts/breadth.mjs",
    "live": "node scripts/live.mjs",
    "adopt": "node scripts/check-adopt.mjs",
    "game": "node scripts/check-game.mjs",
    "modes": "node scripts/check-modes.mjs",
    "ready": "node scripts/check-prepare.mjs",
    "swf": "node scripts/swf-inspect.mjs",
    "flash-hidden": "node scripts/check-flash-window.mjs",
    "flash-mirror": "node scripts/check-flash-mirror.mjs",
    "flash-tools": "node scripts/check-flash-tools.mjs",
    "flash-local": "node scripts/check-flash-local.mjs",
    "keys": "node scripts/keyboard.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-inner-browser-use.git"
  },
  "homepage": "https://github.com/regrevia/dsh-inner-browser-use#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-inner-browser-use/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
